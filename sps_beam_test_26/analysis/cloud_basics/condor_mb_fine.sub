# condor_mb_fine.sub -- the fine Magboltz grids (make_fine_jobs.py, MB_FINE_2026-10-31.md), one (mixture, field) per job.
# Run in lxplus ~/x17rerun/mb_fine with magboltz_drift.py, setup_garfield.sh, condor_mb_hs.sh beside it (copied from
# ~/cloud_basics_condor/att) and JOBS=<jobs file>.  Each job returns one small JSON into the submit dir.
executable = condor_mb_hs.sh
arguments = $(tag) $(field) $(ncoll)
transfer_input_files = magboltz_drift.py, setup_garfield.sh, /afs/cern.ch/user/d/dneff/work/garfield_install/garfield-927e5c21.tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
output = log/mbf_$(tag)_$(field).out
error = log/mbf_$(tag)_$(field).err
log = log/mbf.log
requirements = (Machine != "b9g42p2031.cern.ch")
max_retries = 3
+JobFlavour = "workday"
priority = 20
queue tag, field, ncoll from $(JOBS)
