universe                = vanilla
executable              = run_vscan.sh
arguments               = $(det) $(cache) $(arm) $(kb) $(vs)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = payload.tar.gz, arm_$(det)_$(arm).json
transfer_output_files   = vscan_$(det)_$(arm)_k$(kb).json
transfer_output_remaps  = "vscan_$(det)_$(arm)_k$(kb).json = out/vscan_$(det)_$(arm)_k$(kb).json"
output                  = log/$(det)_$(arm)_k$(kb).out
error                   = log/$(det)_$(arm)_k$(kb).err
log                     = log/vscan.log
request_cpus            = 8
request_memory          = 8GB
request_disk            = 4GB
environment             = "OMP_NUM_THREADS=8"
+JobFlavour             = "workday"
max_retries             = 2
requirements            = (OpSysAndVer =?= "AlmaLinux9")
queue det, cache, arm, kb, vs from jobs.txt
