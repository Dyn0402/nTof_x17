arguments      = /eos/user/d/dneff/x17rerun/ws_sps code headon_sigma.py --plateau $(plateau) --zs $(zs) --censor $(cens) --chunk $(chunk) 6 --nev 1200 --jobs 4
output         = log/$(ClusterId).$(ProcId).out
error          = log/$(ClusterId).$(ProcId).err
log            = log/ws_sps.log
request_cpus   = 4
request_memory = 4000
+JobFlavour    = "longlunch"
should_transfer_files = NO
