executable     = $ENV(HOME)/x17rerun/maskgate/run_gate.sh
arguments      = $(code) $(det) $(arm)
output         = log/$(det)_$(arm).out
error          = log/$(det)_$(arm).err
log            = log/gate.log
request_cpus   = 8
request_memory = 12000
environment    = "OMP_NUM_THREADS=8"
+JobFlavour    = "workday"
should_transfer_files = NO
queue det, arm from jobs.txt
