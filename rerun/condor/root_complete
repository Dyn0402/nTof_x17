#!/usr/bin/env python3
"""root_complete FILE... -- exit 1 unless every file is a ROOT file exactly as long as its own header says (size == fEND).

A truncated input does not always stop a job: analyze_waveforms read a cut decoded file and exited 0 with a hits file
holding no hits tree (2026-11-04, n_TOF rr1_cm0).  Standard library only.
"""
import os
import struct
import sys


def problem(path):
    try:
        size = os.stat(path).st_size
        with open(path, 'rb') as f:
            h = f.read(64)
    except OSError as e:
        return f'unreadable: {e}'
    if h[:4] != b'root':
        return 'not a ROOT file'
    version = struct.unpack('>i', h[4:8])[0]
    end = struct.unpack('>q', h[16:24])[0] if version >= 1000000 else struct.unpack('>i', h[12:16])[0]
    return None if size == end else f'truncated: {size} bytes, header says {end}'


bad = [(p, problem(p)) for p in sys.argv[1:]]
bad = [(p, why) for p, why in bad if why]
for p, why in bad:
    print(f'root_complete: {p}: {why}', file=sys.stderr)
sys.exit(1 if bad else 0)
