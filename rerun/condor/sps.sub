# one SPS det4 row of the pass (rerun/model_audit/sps_stage.sh from the frozen code archive): args = <key> <out dir>
executable     = /bin/bash
arguments      = $(code)/rerun/model_audit/sps_stage.sh $(code) $(args)
output         = log/$(node).out
error          = log/$(node).err
log            = log/pass1.log
request_cpus   = $(cpus)
request_memory = $(mem)
# the archive is frozen and shared by every job: no bytecode written into it
environment    = "PYTHONDONTWRITEBYTECODE=1"
+JobFlavour    = "workday"
should_transfer_files = NO
queue
