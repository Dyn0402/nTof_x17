# one stage of the from-scratch pass (rerun/stage_job.py), run through bash from the frozen code archive
# (rerun/stage_job.sh in $(code)), never a separately deployed copy (10-29: ~/x17rerun/stage_job.sh was stale)
executable     = /bin/bash
arguments      = $(code)/rerun/stage_job.sh $(code) $(args)
output         = log/$(node).out
error          = log/$(node).err
log            = log/pass1.log
request_cpus   = $(cpus)
request_memory = $(mem)
# the archive is frozen and shared by every job: no bytecode written into it
environment    = "PYTHONDONTWRITEBYTECODE=1"
+JobFlavour    = "workday"
should_transfer_files = NO
queue
