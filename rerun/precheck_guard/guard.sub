universe                = vanilla
executable              = run_guard.sh
arguments               = $(det)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = payload.tar.gz
transfer_output_files   = guard_$(det).json
transfer_output_remaps  = "guard_$(det).json = out/guard_$(det).json"
output                  = log/$(det).out
error                   = log/$(det).err
log                     = log/guard.log
request_cpus            = 4
request_memory          = 8GB
request_disk            = 4GB
environment             = "OMP_NUM_THREADS=4"
+JobFlavour             = "workday"
max_retries             = 2
requirements            = (OpSysAndVer =?= "AlmaLinux9")
queue det in (det2, det3, det4, det6, det7)
