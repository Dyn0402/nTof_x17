#  condor_submit inject.sub -a 'runs=runs.txt'
universe                = vanilla
executable              = inject_job.sh
arguments               = $(run)
runs                    = runs_inject.txt
transfer_input_files    = ntof_scint_recovery
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
output                  = logs/inj_$(run).out
error                   = logs/inj_$(run).err
log                     = logs/inj.log
request_cpus            = 1
request_memory          = 6 GB
request_disk            = 4 GB
+JobFlavour             = "workday"
MY.WantOS               = "el9"
MY.SendCredential       = true
on_exit_remove          = (ExitCode =?= 0)
max_retries             = 2
queue run from $(runs)
