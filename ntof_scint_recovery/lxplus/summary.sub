#  condor_submit summary.sub -a 'runs=runs.txt'
universe                = vanilla
executable              = summary_job.sh
arguments               = $(run)
runs                    = runs.txt
transfer_input_files    = ntof_scint_recovery
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
output                  = logs/sum_$(run).out
error                   = logs/sum_$(run).err
log                     = logs/sum.log
request_cpus            = 1
request_memory          = 4 GB
request_disk            = 4 GB
+JobFlavour             = "longlunch"
MY.WantOS               = "el9"
MY.SendCredential       = true
on_exit_remove          = (ExitCode =?= 0)
max_retries             = 2
queue run from $(runs)
