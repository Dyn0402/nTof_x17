# MPGD26 full-June wft reconstruction campaign — one job per manifest row.
# Submit from the package directory (make_reco_package.py builds it):
#   condor_submit reco.sub                       # phase 1: jobs.txt = gate
#   condor_submit jobfile=jobs_rest.txt reco.sub # phase 2, after gate_eval
jobfile                 = jobs.txt
universe                = vanilla
executable              = run_reco_wrapper.sh
arguments               = "$(row) $(tag) $(extra)"
transfer_input_files    = code.tar.gz, bundles.tar.gz, run_reco_job.py, campaign_manifest.csv
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = reco_r$(row)_$(tag).tar.gz
initialdir              = .
output                  = log/reco_r$(row)_$(tag).out
error                   = log/reco_r$(row)_$(tag).err
log                     = log/reco.log
request_cpus            = 8
request_memory          = 6000MB
environment             = "RECO_JOBS=8"
+JobFlavour             = "workday"
MY.SendCredential       = true
on_exit_hold            = (ExitBySignal == True) || (ExitCode != 0)
max_retries             = 2
queue row,tag,extra from $(jobfile)
