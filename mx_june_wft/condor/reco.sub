# MPGD26 full-June wft reconstruction campaign — one job per manifest row.
# Submit from the package directory (make_reco_package.py builds it):
#   condor_submit reco.sub                       # phase 1: jobs.txt = gate
#   condor_submit jobfile=jobs_rest.txt reco.sub # phase 2, after gate_eval
# A plain `jobfile = jobs.txt` here would override the command line — submit
# file assignments win over `condor_submit jobfile=...`. Guard it so the
# phase-2 override actually takes.
if ! defined jobfile
  jobfile               = jobs.txt
endif
universe                = vanilla
executable              = run_reco_wrapper.sh
arguments               = "$(row) $(tag) $(extra)"
# $(mlist) is the row's locally-computed M3-matched event list. Every job gets
# one: LCG_105 mis-resolves the NClus branches of v1 rays files (184 of 214
# rows), silently degrading the recipe to chi2-only, so the worker must not do
# the M3 read at all. Shipping the list for v2 rows too keeps one code path.
transfer_input_files    = code.tar.gz, bundles.tar.gz, run_reco_job.py, campaign_manifest.csv, matched_lists/$(mlist)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = reco_r$(row)_$(tag).tar.gz
initialdir              = .
output                  = log/reco_r$(row)_$(tag).out
error                   = log/reco_r$(row)_$(tag).err
log                     = log/reco.log
request_cpus            = 8
request_memory          = 6000MB
environment             = "RECO_JOBS=8"
+JobFlavour             = "workday"
MY.SendCredential       = true
on_exit_hold            = (ExitBySignal == True) || (ExitCode != 0)
max_retries             = 2
# Column order matters: condor splits queue items on whitespace AS WELL AS
# commas, and only the LAST variable absorbs the remainder of the line. $(extra)
# holds space-separated flags, so it has to be last -- put $(mlist) after it and
# every job silently gets extra="--bundle-name" with the rest swallowed by mlist.
queue row,tag,mlist,extra from $(jobfile)
