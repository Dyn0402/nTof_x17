# Stage-1 candidate filter over the frozen campaign sample -- one job per
# sub-run. Submit from the package directory make_stage1_package.py builds:
#   condor_submit stage1.sub
#
# Sizing, measured on run_79/stat090_0000 (109 354 triggers, 13 tags, 1.2 GB):
#   ~25 ev/s single-process -> 1-1.5 h wall, so "workday" (8 h) with headroom.
#   1 CPU: candidate_filter walks tags sequentially and does not thread.
#   disk 6 GB: the staged sub-run is 1.2-2 GB and the output is a few MB.
if ! defined jobfile
  jobfile               = jobs.txt
endif
universe                = vanilla
executable              = run_stage1_wrapper.sh
arguments               = "$(run) $(subrun)"
transfer_input_files    = code.tar.gz, PROVENANCE.txt
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""
initialdir              = .
# AFS caps entries PER DIRECTORY; a 22k-file log dir degraded the shared
# schedd on 2026-09-09. stdout goes nowhere (the EOS product and the
# wrapper exit code carry everything), and no marker is transferred back.
# Only stderr is kept, one file per job, for diagnosis.
output                  = /dev/null
error                   = log/stage1_$(run)_$(subrun).err
log                     = log/stage1.log
request_cpus            = 1
request_memory          = 6000MB
request_disk            = 6000MB
+JobFlavour             = "workday"
MY.SendCredential       = true
on_exit_hold            = (ExitBySignal == True) || (ExitCode != 0)
max_retries             = 2
queue run,subrun from $(jobfile)
