  "_schema": {
    "usage": "t_flash_at_detector(bunch) = tof_PKUP(bunch) + C_ns",
    "reference": "PKUP pulse time: tof of the largest-amplitude PKUP hit of that bunch (numerically equal to the PKUP tflash, whose finder never fails)",
    "sign": "C_ns is NEGATIVE: the flash reaches the detectors ~1.7 us BEFORE the pickup pulse appears in the digitiser window",
    "scope": "C is an instrumental constant (flight + cable + front-end). It does not depend on the SiPM divert state, so it applies to every run in the campaign, not only the divert-off ones.",
    "units": "ns"
  },
