# Condor submit for the n_TOF -> DREAM slim. One job = one n_TOF run.
#
#   ssh -K lxplus                       # -K is mandatory: no token, no EOS
#   cd ~/x17slim                        # staged by stage.sh
#   myschedd bump                       # pick a schedd (prints e.g. bigbird25)
#   condor_submit slim.sub run=224572
#   condor_q  <id> -name <schedd>       # status  (re-pass -name each session)
#   condor_tail <id> -name <schedd>     # live stdout
#
# Many runs at once -- the ready list comes from segments.py:
#   python3 ntof_processing/slim_pipeline/segments.py --ready \
#     | awk '/^n_TOF/ {print $2}' > ready_runs.txt
#   condor_submit slim.sub -queue run from ready_runs.txt
#
# Outputs land in ~/x17slim/out/runs/<run>/<subrun>/ntof_hits/. Push to EOS with
#   ./publish_to_eos.sh out
#
# Sizing, measured on the real thing: n_TOF 224572, 3 DREAM sub-runs,
#   xrdcp 30 GB in 133 s, then 646 + 575 + 452 s of segment
#   = 28.0 min wall, peak RSS 3.16 GB, single core.
# Budget ~10 min per DREAM sub-run plus ~2.5 min for the copy.

universe                = vanilla
executable              = slim_wrapper.sh
arguments               = $(run)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
# NO trailing slashes. `dir/` transfers the CONTENTS of dir into the scratch
# root and flattens the package layout; `dir` transfers the directory itself,
# which is what the imports need.
transfer_input_files    = ntof_processing,ntof_dream_merge,ntof_july_analysis,common,mx_july_beam_qa
transfer_output_files   = out

output                  = log/slim_$(run)_$(ClusterId).out
error                   = log/slim_$(run)_$(ClusterId).err
log                     = log/slim_$(run)_$(ClusterId).log

request_cpus            = 1
# Measured on the first full job (224572, 3 segments): peak RSS 3.16 GB. 5 GB is
# ~1.6x that. Do not inflate it -- CERN scales the CPU allocation with memory
# (the 9 GB first attempt was given 3 cores for a single-threaded job) and a
# bigger ask waits longer for a slot.
request_memory          = 5 GB
# 45 GB: the n_TOF run (30-45 GB) is copied into node-local scratch.
request_disk            = 45 GB
# workday = 8 h. A 3-segment run is ~30 min plus the xrdcp.
# NOTE condor does NOT accept a trailing "# comment" on a value line -- it
# parses it as part of the expression. Keep comments on their own line.
+JobFlavour             = "workday"

# Fail loudly rather than silently retrying onto a bad node.
max_retries             = 1
requirements            = (OpSysAndVer =?= "AlmaLinux9")

queue
