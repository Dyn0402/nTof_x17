# One-off: slim a subset of bunches at +-10 us to see the shape of the plastic
# late tail, which decides how wide the campaign window has to be.
#
#   condor_submit probe.sub run=224572 -queue 1
#
# Same sizing as slim.sub but the window is 66x wider on a ~7 % subset of
# bunches, so the hit count lands in the same ballpark.

universe                = vanilla
executable              = probe_wrapper.sh
arguments               = $(run)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = ntof_processing,ntof_dream_merge,ntof_july_analysis,common,mx_july_beam_qa
transfer_output_files   = probe
transfer_output_remaps  = "probe = probe_$(run)"

output                  = log/probe_$(run)_$(ClusterId).out
error                   = log/probe_$(run)_$(ClusterId).err
log                     = log/probe_$(run)_$(ClusterId).log

request_cpus            = 1
request_memory          = 6 GB
request_disk            = 45 GB
+JobFlavour             = "workday"
max_retries             = 0
requirements            = (OpSysAndVer =?= "AlmaLinux9")
