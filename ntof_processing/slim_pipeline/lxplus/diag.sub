# Diagnose a segment that found no coincidence peak.
#   condor_submit diag.sub run=224642 drun=run_118 dsub=stat090_0003 -queue 1
universe                = vanilla
executable              = diag_wrapper.sh
arguments               = $(run) $(drun) $(dsub)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = ntof_processing,ntof_dream_merge,ntof_july_analysis,common,mx_july_beam_qa
transfer_output_files   = diag
transfer_output_remaps  = "diag = diag_$(drun)_$(dsub)_$(run)"
output                  = log/diag_$(run)_$(ClusterId).out
error                   = log/diag_$(run)_$(ClusterId).err
log                     = log/diag_$(run)_$(ClusterId).log
request_cpus            = 1
request_memory          = 6 GB
request_disk            = 45 GB
+JobFlavour             = "workday"
max_retries             = 0
requirements            = (OpSysAndVer =?= "AlmaLinux9")
